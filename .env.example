# Optional per-project settings. Set production values in Netlify Functions scope.
# Public sources and managed storage are available with no external API keys.
# Never prefix private values with VITE_.
DISABLED_FEEDS=
GUARDIAN_API_KEY=
REDDIT_APPROVED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# The default uses runtime-injected Netlify AI Gateway credentials when available.
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
AI_BASE_URL=
AI_DAILY_LIMIT=25
AI_VISITOR_DAILY_LIMIT=5
EOTW_IDENTITY_ENABLED=false
